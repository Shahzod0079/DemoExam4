<UserControl x:Class="DemoExam4.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DemoExam4.Elements"
             mc:Ignorable="d" >
    <Grid Background="Wheat" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Label x:Name="lName" Content="Наименование:" VerticalAlignment="Top" 
               Grid.Column="0" FontSize="16" Margin="10,0,0,0" />
        <Label x:Name="lResponsible" Content="Ответственный:" VerticalAlignment="Top" 
               Grid.Column="0" FontSize="16" Margin="10,30,0,0" />
        <Label x:Name="lCounterparty" Content="Контрагент:" VerticalAlignment="Top" 
               Grid.Column="0" FontSize="16" Margin="10,60,0,0" />
        <Label x:Name="lOrganization" Content="Организация:" VerticalAlignment="Top" 
               Grid.Column="1" FontSize="16" Margin="10,0,0,0" />
        <Label x:Name="lDirection" Content="Направление:" VerticalAlignment="Top" 
               Grid.Column="1" FontSize="16" Margin="10,30,0,0" />
        <Label x:Name="lStatus" Content="Статус:" VerticalAlignment="Top" 
               Grid.Column="1" FontSize="16" Margin="10,60,0,0" />

        <Button Click="Update" Content="Изменить" Width="100" Height="30" VerticalAlignment="Top" 
                Margin="10,10,10,0" Grid.Column="2" HorizontalAlignment="Right" />
        <Button Click="Delete" Content="Удалить" Width="100" Height="30" VerticalAlignment="Top" 
                Margin="10,50,10,0" Grid.Column="2" HorizontalAlignment="Right" />
    </Grid>
</UserControl>
