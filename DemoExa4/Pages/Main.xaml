<Page x:Class="DemoExam4.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DemoExam4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main">

    <Grid Background="White">
        <Grid Background="Blue" VerticalAlignment="Top" Height="60">
            <Label Content="Реестр докмунетов" VerticalContentAlignment="Center" FontSize="20" 
                   FontWeight="Bold" Foreground="White" Margin="10"/>

            <Button Click="Add" Content="Добавить" Width="70" Height="40" HorizontalAlignment="Right" Margin="10" />
        </Grid>
        <ScrollViewer Margin="0,70,0,0">
                <StackPanel x:Name="spItems" />
            </ScrollViewer>
        </Grid>
</Page>
