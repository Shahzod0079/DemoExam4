<Page x:Class="DemoExam4.Pages.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DemoExam4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add">

    <Grid Background="White">
        <Grid Background="Blue" VerticalAlignment="Top" Height="70">
            <Label Content="Реестр докмунетов" VerticalContentAlignment="Center" FontSize="20" 
                   FontWeight="Bold" Foreground="White" Margin="10"/>

            <Button Click="Save" Content="Сохранить" Width="80" Height="40" HorizontalAlignment="Right" Margin="10" />
            <Button Click="Back" Content="Назад" Width="80" Height="40" HorizontalAlignment="Left" Margin="614,15,0,15" />
        </Grid>

        <Grid Margin="0,80,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Label x:Name="lName" Content="Наименование" VerticalAlignment="Top"
                   FontSize="16" Grid.Column="0" Grid.Row="0" Margin="10,0,0,0"/>
            <TextBox x:Name="tName" Grid.Row="1" Grid.Column="0" Margin="10,0,0,0" />
            <Label x:Name="lResponsible" Content="Ответственный" VerticalAlignment="Top"
                   FontSize="16" Grid.Column="0" Grid.Row="2" Margin="10,0,0,0"/>
            <TextBox x:Name="tResponsible" Grid.Row="3" Grid.Column="0" Margin="10,0,0,0" />
            <Label x:Name="lCounterparty" Content="Контрагент" VerticalAlignment="Top"
                   FontSize="16" Grid.Column="0" Grid.Row="4" Margin="10,0,0,0"/>
            <TextBox x:Name="tCounterparty" Grid.Row="5" Grid.Column="0" Margin="10,0,0,0"/>

            <Label x:Name="lOrganization" Content="Организация" VerticalAlignment="Top"
        FontSize="16" Grid.Column="2" Grid.Row="0" Margin="0,0,10,0"/>
            <TextBox x:Name="tOrganization" Grid.Row="1" Grid.Column="2" Margin="0,0,10,0" />
            <Label x:Name="lDirection" Content="Направление" VerticalAlignment="Top"
                    FontSize="16" Grid.Column="2" Grid.Row="2" Margin="0,0,10,0"/>
            <TextBox x:Name="tDirection" Grid.Row="3" Grid.Column="2" Margin="0,0,10,0" />
            <Label x:Name="lStatus" Content="Статус" VerticalAlignment="Top"
                    FontSize="16" Grid.Column="2" Grid.Row="4" Margin="0,0,10,0"/>
            <ComboBox x:Name="tStatus" Grid.Row="5" Grid.Column="2" Margin="0,0,10,0" />
        </Grid>
    </Grid>
</Page>
